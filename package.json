{
	"name": "@digidem/nodejs-mobile-test-harness",
	"version": "1.0.0-pre.0",
	"description": "Run a Node project inside nodejs-mobile on an iOS simulator or Android device and exit with node's exit code",
	"keywords": [
		"nodejs-mobile",
		"ios",
		"android",
		"test",
		"tap",
		"simulator",
		"emulator"
	],
	"license": "MIT",
	"author": "Awana Digital",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/digidem/nodejs-mobile-test-harness.git"
	},
	"homepage": "https://github.com/digidem/nodejs-mobile-test-harness#readme",
	"bugs": {
		"url": "https://github.com/digidem/nodejs-mobile-test-harness/issues"
	},
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./src/index.js"
		},
		"./package.json": "./package.json"
	},
	"files": [
		"src",
		"dist",
		"ios",
		"android"
	],
	"engines": {
		"node": ">=22"
	},
	"publishConfig": {
		"access": "public",
		"tag": "next"
	},
	"sideEffects": false,
	"scripts": {
		"build": "rimraf dist && tsc -p tsconfig.build.json",
		"prepack": "npm run build",
		"prepare": "husky",
		"format": "prettier --write .",
		"test": "run-s test:types test:lint test:unused test:unit",
		"test:types": "tsc",
		"test:lint": "eslint",
		"test:unused": "knip",
		"test:unit": "node --test \"test/**/*.test.js\"",
		"coverage": "c8 --reporter=lcov --reporter=text node --test \"test/**/*.test.js\"",
		"check:pkg": "npm run build && publint && attw --pack --profile esm-only",
		"changeset": "changeset",
		"release": "changeset publish --tag next"
	},
	"prettier": {
		"semi": false,
		"singleQuote": true,
		"useTabs": true,
		"importOrder": [
			"^node:",
			"<THIRD_PARTY_MODULES>",
			"^[./]"
		],
		"importOrderSeparation": true,
		"plugins": [
			"@trivago/prettier-plugin-sort-imports"
		],
		"overrides": [
			{
				"files": "*.md",
				"options": {
					"useTabs": false
				}
			}
		]
	},
	"lint-staged": {
		"*.{js,mjs,cjs,ts,mts,cts}": "eslint --cache --fix",
		"*": "prettier --write --ignore-unknown"
	},
	"devDependencies": {
		"@arethetypeswrong/cli": "^0.18.5",
		"@changesets/changelog-github": "^1.0.1",
		"@changesets/cli": "^3.0.3",
		"@eslint/js": "^10.0.1",
		"@trivago/prettier-plugin-sort-imports": "^6.0.2",
		"@types/node": "^22.20.5",
		"c8": "^12.0.0",
		"eslint": "^10.13.0",
		"globals": "^17.13.0",
		"husky": "^9.1.7",
		"knip": "^6.42.1",
		"lint-staged": "^17.6.0",
		"npm-run-all2": "^9.0.4",
		"prettier": "^3.9.10",
		"publint": "^0.3.25",
		"rimraf": "^6.1.3",
		"typescript": "~6.0",
		"typescript-eslint": "^8.72.0"
	},
	"dependencies": {
		"custom-error-creator": "^1.4.0"
	},
	"bin": {
		"nodejs-mobile-test": "./src/cli.js"
	}
}
